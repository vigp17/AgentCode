# Copy to .env and fill in the keys you use.
# AgentCode loads .env from the project root automatically.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# AGENTCODE_MODEL=claude-sonnet-5
# AGENTCODE_MAX_ITERATIONS=25
# AGENTCODE_MAX_SUBAGENT_DEPTH=1
# AGENTCODE_DISABLE_DISCOVERY=1        # don't query providers for new models
# AGENTCODE_MODELS_TTL_HOURS=24        # how long the discovered-model list is cached

# AgentCode lineup endpoints (any OpenAI-compatible server)
# AGENTCODE_FT_AXON_1_API_BASE=http://localhost:8002/v1
# AGENTCODE_FT_TANDAV_1_API_BASE=http://localhost:8003/v1
# AGENTCODE_FT_VEDA_1_API_BASE=
# AGENTCODE_FT_CHITRA_1_API_BASE=

# AgentCode fine-tuned models (see finetune/README.md)
# AGENTCODE_FT_LIGHT_API_BASE=http://localhost:8001/v1
# AGENTCODE_FT_MEDIUM_API_BASE=http://localhost:8002/v1
# AGENTCODE_FT_HEAVY_API_BASE=http://localhost:8003/v1
# AGENTCODE_FT_API_KEY=
