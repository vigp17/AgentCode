{
  "name": "agentcode-heavy",
  "tier": "heavy",
  "base_model": "Qwen/Qwen2.5-Coder-32B-Instruct",
  "description": "Multi-file, long-horizon agent work. Trained on every trajectory, including the longest.",
  "data": {"max_tool_calls": null, "max_chars": 120000},
  "lora": {"r": 64, "alpha": 128, "dropout": 0.0},
  "train": {
    "max_seq_length": 32768,
    "load_in_4bit": true,
    "epochs": 2,
    "learning_rate": 5e-5,
    "per_device_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "warmup_ratio": 0.03
  },
  "hardware": "1x 80GB GPU (A100/H100), ~10h per 5k examples"
}
