{
  "name": "agentcode-light",
  "tier": "light",
  "base_model": "Qwen/Qwen3-4B-Instruct-2507",
  "params": "4B dense",
  "description": "Fast, cheap model for explanations, lookups and small edits. Runs on a single consumer GPU.",
  "data": {"max_tool_calls": 3, "max_chars": 24000},
  "lora": {
    "r": 16, "alpha": 32, "dropout": 0.0,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "train": {
    "max_seq_length": 8192,
    "load_in_4bit": false,
    "epochs": 3,
    "learning_rate": 2e-4,
    "per_device_batch_size": 4,
    "gradient_accumulation_steps": 4,
    "warmup_ratio": 0.03
  },
  "hardware": "train: 1x 24GB GPU (16GB with load_in_4bit). serve: 1x 16GB GPU, or CPU/laptop via GGUF"
}
