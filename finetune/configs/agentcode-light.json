{
  "name": "agentcode-light",
  "tier": "light",
  "base_model": "Qwen/Qwen2.5-Coder-1.5B-Instruct",
  "description": "Fast, cheap model for explanations, lookups and small edits. Runs on a laptop GPU.",
  "data": {"max_tool_calls": 3, "max_chars": 24000},
  "lora": {"r": 16, "alpha": 32, "dropout": 0.0},
  "train": {
    "max_seq_length": 8192,
    "load_in_4bit": false,
    "epochs": 3,
    "learning_rate": 2e-4,
    "per_device_batch_size": 4,
    "gradient_accumulation_steps": 4,
    "warmup_ratio": 0.03
  },
  "hardware": "1x 16GB GPU (T4/L4/RTX 4080), ~1h per 5k examples"
}
